{
  "info": {
    "name": "Job Portal API",
    "description": "API collection for Job Portal Spring Boot app (port 8081)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register - Job Seeker",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:8081/api/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Seeker\",\n  \"email\": \"bob@gmail.com\",\n  \"password\": \"pass123\",\n  \"role\": \"JOBSEEKER\",\n  \"skills\": \"Java, Spring Boot, SQL\",\n  \"resumeUrl\": \"https://resume.io/bob\"\n}"
            }
          }
        },
        {
          "name": "Register - Recruiter",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:8081/api/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice HR\",\n  \"email\": \"alice@techcorp.com\",\n  \"password\": \"pass123\",\n  \"role\": \"RECRUITER\",\n  \"companyName\": \"TechCorp\",\n  \"jobRole\": \"HR Manager\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:8081/api/users/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@gmail.com\",\n  \"password\": \"pass123\"\n}"
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/users/1"
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:8081/api/users/2",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Updated\",\n  \"skills\": \"Java, Spring Boot, SQL, React\",\n  \"resumeUrl\": \"https://resume.io/bob-v2\"\n}"
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/users"
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Get All Jobs",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/jobs"
          }
        },
        {
          "name": "Get Job by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/jobs/1"
          }
        },
        {
          "name": "Search Jobs by Keyword",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8081/api/jobs/search?keyword=java",
              "query": [{ "key": "keyword", "value": "java" }]
            }
          }
        },
        {
          "name": "Search Jobs by Location",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8081/api/jobs/search?location=bangalore",
              "query": [{ "key": "location", "value": "bangalore" }]
            }
          }
        },
        {
          "name": "Post a Job (Recruiter)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:8081/api/jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Java Backend Developer\",\n  \"description\": \"Need Spring Boot developer with 2+ years experience.\",\n  \"location\": \"Bangalore\",\n  \"salary\": \"8-12 LPA\",\n  \"company\": \"TechCorp\",\n  \"recruiterId\": 1\n}"
            }
          }
        },
        {
          "name": "Update Job",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:8081/api/jobs/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Java Developer\",\n  \"description\": \"Updated description here\",\n  \"location\": \"Bangalore\",\n  \"salary\": \"12-18 LPA\",\n  \"company\": \"TechCorp\",\n  \"status\": \"ACTIVE\"\n}"
            }
          }
        },
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:8081/api/jobs/1"
          }
        },
        {
          "name": "Get Jobs by Recruiter",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/jobs/recruiter/1"
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Apply for Job",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:8081/api/applications/apply",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": 1,\n  \"applicantId\": 2\n}"
            }
          }
        },
        {
          "name": "Get Applications by User",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/applications/user/2"
          }
        },
        {
          "name": "Get Applicants for Job (Recruiter View)",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/applications/job/1"
          }
        },
        {
          "name": "Update Application Status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:8081/api/applications/1/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHORTLISTED\"\n}"
            }
          }
        },
        {
          "name": "Get All Applications",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/applications"
          }
        }
      ]
    },
    {
      "name": "Saved Jobs",
      "item": [
        {
          "name": "Save a Job",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "http://localhost:8081/api/saved",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"jobId\": 2\n}"
            }
          }
        },
        {
          "name": "Get Saved Jobs for User",
          "request": {
            "method": "GET",
            "url": "http://localhost:8081/api/saved/user/2"
          }
        },
        {
          "name": "Remove Saved Job",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:8081/api/saved/1"
          }
        }
      ]
    }
  ]
